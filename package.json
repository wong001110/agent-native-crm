{
  "name":"agent-native-crm",
  "version":"0.1.0",
  "private":true,
  "type":"module",
  "engines":{"node":">=22.16.0"},
  "scripts":{
    "dev":"next dev --hostname 127.0.0.1",
    "build":"next build",
    "start":"next start --hostname 127.0.0.1",
    "typecheck":"tsc --noEmit",
    "test":"vitest run",
    "test:e2e":"playwright test",
    "db:setup":"node --env-file-if-exists=.env.local --import tsx scripts/setup-db.ts",
    "test:live":"node --env-file-if-exists=.env.local --import tsx scripts/live-smoke.ts",
    "continuity:check":"python3 scripts/check-continuity.py"
  },
  "dependencies":{
    "next":"^16.0.0","react":"^19.2.0","react-dom":"^19.2.0",
    "ai":"^6.0.0","@ai-sdk/deepseek":"^2.0.0","zod":"^4.0.0",
    "drizzle-orm":"^0.44.0","postgres":"^3.4.7",
    "@base-ui/react":"^1.0.0","class-variance-authority":"^0.7.1","clsx":"^2.1.1","tailwind-merge":"^3.0.0","lucide-react":"^0.468.0","server-only":"0.0.1"
  },
  "devDependencies":{
    "typescript":"^5.9.3","@types/node":"^22.0.0","@types/react":"^19.2.0","@types/react-dom":"^19.2.0",
    "tailwindcss":"^4.1.0","@tailwindcss/postcss":"^4.1.0","postcss":"^8.5.6","tw-animate-css":"^1.3.0",
    "vitest":"^3.2.4","tsx":"^4.20.0","@playwright/test":"^1.56.0","@axe-core/playwright":"^4.10.0"
  }
