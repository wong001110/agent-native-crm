# Credential-free local demo. Mock is scripted; it does not prove LLM quality.
AGENT_MODE=mock
DB_MODE=demo
DEMO_DATA_FILE=.data/crm.json

# Real provider: explicitly set AGENT_MODE=live, then supply BOTH values.
# Keep every value here server-only. Never use NEXT_PUBLIC_ for secrets.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
# Optional, trusted server configuration only; defaults to official API.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Real database: set DB_MODE=postgres and run npm run db:setup.
DATABASE_URL=

# Require a password when exposing a live or database-backed instance.
# Browser HTTP Basic username is demo.
APP_PASSWORD=
APP_ORIGIN=http://localhost:3000
