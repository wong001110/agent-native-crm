# Explicit simulation. Never silently fall back from live to mock.
AI_MODE=mock
DEEPSEEK_API_KEY=
# Set a model ID actually supported by your DeepSeek account before live validation.
DEEPSEEK_MODEL=
# Optional, server-only. Defaults to the official provider endpoint.
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Empty uses persistent local PGlite. External PostgreSQL is required on serverless.
DATABASE_URL=
PGLITE_DATA_DIR=.data/crm
# Required for live mode; do not commit actual values.
APP_PASSWORD=
SESSION_SECRET=
# Recommended when behind a proxy, for same-origin mutation validation.
APP_ORIGIN=http://localhost:3000
