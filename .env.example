# Explicit fixture mode. Fixture tests do not validate real inference.
AGENT_MODE=mock
# Local development database only. Use a real URL for hosted PostgreSQL.
DATABASE_URL=postgresql://crm:crm_local_only@localhost:5432/agent_native_crm
# Set a random 32+ character value for sessions (required for production/live).
SESSION_SECRET=
# Required in live mode. Never use NEXT_PUBLIC_ for any credential.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Shared demo access token, required before enabling live mode.
DEMO_ACCESS_TOKEN=
